# PLANTILLA — este archivo SÍ se commitea. Nunca pongas valores reales aquí.
# Copiar a .env.local (ignorado por git) y rellenar allí.

# PÚBLICO — se envía al navegador, no es secreto.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRETO — solo servidor. Salta RLS por completo.
# Nunca lo prefijes con NEXT_PUBLIC_, nunca lo importes desde un componente
# cliente, nunca lo pegues en un chat o un issue.
SUPABASE_SECRET_KEY=sb_secret_...

# SECRETO — solo para migraciones y scripts locales.
# Settings → Database → Connection string → pestaña "Session pooler".
# La conexión directa (db.<ref>.supabase.co) es solo IPv6 y no resuelve en
# muchas redes; el pooler sí.
SUPABASE_DB_URL=postgresql://postgres.TU-REF:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres

# Negocio
BUSINESS_TIMEZONE=America/Caracas
NEXT_PUBLIC_SITE_URL=https://reserve.lngeneralservices.com

# Puerta de acceso mientras el sitio está en desarrollo.
#
# Vercel no protege el dominio propio en producción salvo en el plan Pro, así
# que esto lo cubre: con la variable definida, el sitio pide contraseña y no se
# indexa. Los webhooks y el cron quedan fuera, porque traen su propia
# autenticación.
#
# Al abrir al público, se borra la variable y la puerta desaparece.
SITE_PASSWORD=

# Email transaccional
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=reservas@reserve.lngeneralservices.com

# SECRETO — protege /api/cron/*. Vercel lo envía como Authorization: Bearer
# cuando la variable existe en el proyecto. Generar con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# Stripe — tarjetas internacionales
# ---------------------------------------------------------------------------
# En sandbox las claves empiezan por sk_test_ y whsec_. Se obtienen sin
# verificación de negocio, así que sirven para desarrollar la integración
# completa. Activar cobros reales sí exige entidad en un país soportado, y
# Venezuela no lo está.
#
# SECRETO — Dashboard → Developers → API keys → Secret key
STRIPE_SECRET_KEY=sk_test_...
#
# SECRETO — firma de los webhooks. En local sale de la CLI de Stripe:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# En producción, de Dashboard → Developers → Webhooks → tu endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
